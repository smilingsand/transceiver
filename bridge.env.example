# UTF-8; copy to bridge.env and replace placeholder paths with verified local values.
# Only non-secret settings. Never put OpenAI_Tunnel_API_KEY or Tunnel_ID here.
# Values are literal: no variable/command expansion or backslash escaping.

TUNNEL_PROFILE=transceiver
TUNNEL_EXE="C:\Program Files\tunnel-client\tunnel-client.exe"
GIT_EXE="C:\Program Files\Git\mingw64\bin\git.exe"
NODE_EXE=node.exe
PORT=8876

CODEX_BIN="C:\Path To Verified Codex"
CODEX_VERSION=your-tested-version

CODEX_MCP_BRIDGE_DEFAULT_SANDBOX=read-only
CODEX_MCP_BRIDGE_DEFAULT_ACCESS_STRATEGY=read-only
CODEX_MCP_BRIDGE_ALLOW_WRITE=0
CODEX_MCP_BRIDGE_ALLOW_DANGER_FULL_ACCESS=0

# Bridge readiness budget in seconds (1-3600); CLI -BridgeStartupTimeoutSeconds wins.
BRIDGE_STARTUP_TIMEOUT_SECONDS=30
# Controller log retention (LastWriteTime); 1-3650 days. Active logs are protected.
LOG_RETENTION_DAYS=7
